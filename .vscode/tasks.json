{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Main",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/std:c++latest",
                "/Fe${workspaceFolder}\\main.exe",
                "/I${workspaceFolder}\\include",
                "${workspaceFolder}\\main.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "Build Tests",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/std:c++17",
                "/Fe${workspaceFolder}\\tests.exe",
                "/I${workspaceFolder}\\include",
                "/IC:\\googletest-1.14.0\\googletest\\include",
                "${workspaceFolder}\\tests\\test_shapes.cpp",
                "C:\\googletest-1.14.0\\build\\lib\\Release\\gtest.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Run Main",
            "type": "shell",
            "command": "${workspaceFolder}\\main.exe",
            "dependsOn": ["Build Main"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "${workspaceFolder}\\tests.exe",
            "dependsOn": ["Build Tests"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "del /Q ${workspaceFolder}\\*.exe ${workspaceFolder}\\*.obj 2>nul",
            "problemMatcher": []
        }
    ]
}